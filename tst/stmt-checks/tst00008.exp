     1   type MONTH_NAME is (JANUARY, FEBRUARY, MARCH, APRIL, MAY, JUNE, JULY,
     2           AUGUST, SEPTEMBER, OCTOBER, NOVEMBER, DECEMBER);
     3   MONTH : MONTH_NAME;
     4   DAY : INTEGER range 1 .. 31;
     5   YEAR : INTEGER;
     6
     7   MONTH := DECEMBER;
     8   DAY := 31;
     9   YEAR := 2026;
    10
    11   if MONTH = DECEMBER and DAY = 31 then
    12       MONTH := JANUARY;
    13       DAY := 1;
    14       YEAR := YEAR + 1;
    15   end if;
